# generated by gitident from profile "work" — do not edit
[user]
	name = Kirill
	email = kirill@company.com
	signingkey = ABCDEF1234567890
[commit]
	gpgsign = true
[gpg]
	format = openpgp
[core]
	sshCommand = "ssh -i ~/.ssh/id_work -o IdentitiesOnly=yes"
	editor = "code --wait"
[alias]
	lg = "log --graph --format=\"%h %s\""
[pull]
	rebase = true
[remote "origin"]
	prune = true
[url "git@github.com:"]
	insteadOf = https://github.com/
